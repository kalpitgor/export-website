# Cloudflare Pages cache rules

# Astro build output — filenames are content-hashed, safe to cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Product photos and logos — cached 30 days in the browser, revalidated in the background
# after that. (Rules that both match get merged, so keep these from overlapping.)
# If you replace a photo, give it a new filename (e.g. -02) so visitors see it right away.
/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/*.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
