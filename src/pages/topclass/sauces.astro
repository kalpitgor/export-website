---
import Layout from '../../layouts/Layout.astro';
import InquiryForm from '../../components/InquiryForm.astro';

const sauces = [
  {
    name: 'Red Chilli Sauce',
    desc: 'Classic heat-forward red chilli sauce. Versatile across cuisines — table use, cooking and HoReCa applications.',
    packs: ['200g', '630g', '1kg', '5kg', 'Sachets', '5L'],
    color: 'from-red-50 to-rose-50',
    border: 'border-red-100',
  },
  {
    name: 'Green Chilli Sauce',
    desc: 'Fresh, tangy green chilli sauce. Light heat with bright flavour. Popular for snacks and dips.',
    packs: ['200g', '630g', '1kg', '5kg', 'Sachets', '5L'],
    color: 'from-green-50 to-lime-50',
    border: 'border-green-100',
  },
  {
    name: 'Soya Sauce',
    desc: 'Rich, umami-forward soya sauce. Ideal for Asian-style cooking, marinades and stir-fry applications.',
    packs: ['200g', '630g', '1kg', '5kg', 'Sachets', '5L'],
    color: 'from-stone-50 to-amber-50',
    border: 'border-stone-200',
  },
  {
    name: 'Vinegar',
    desc: 'Clean, sharp distilled vinegar. Multipurpose condiment and preservation ingredient.',
    packs: ['200g', '630g', '1kg', '5kg', 'Sachets', '5L'],
    color: 'from-amber-50 to-yellow-50',
    border: 'border-amber-100',
  },
  {
    name: 'Tomato Ketchup',
    desc: 'Smooth, sweet-tangy tomato ketchup. Bulk-pack option for QSR, HoReCa and food service chains.',
    packs: ['200g', '630g', '1kg', '5kg', 'Sachets', '5L'],
    color: 'from-orange-50 to-red-50',
    border: 'border-orange-100',
  },
  {
    name: 'Schezwan Chutney',
    desc: 'Spicy, aromatic Schezwan-style chutney. Premium heat with complex flavour depth.',
    packs: ['200g', '630g', '1kg', '5kg', 'Sachets', '5L'],
    color: 'from-rose-50 to-orange-50',
    border: 'border-rose-100',
  },
];

const packSizes = ['200g Retail', '630g Jar', '1kg Pack', '5kg Catering', 'Sachets (Portion)', '5L Bulk'];
---

<Layout
  title="Sauces & Condiments — Top Class"
  description="Red chilli, green chilli, soya sauce, vinegar, tomato ketchup and schezwan chutney. Multiple pack sizes for HoReCa and retail."
>
  <!-- HERO -->
  <section class="relative min-h-[50vh] flex items-center overflow-hidden bg-brand-dark">
    <div class="absolute inset-0">
      <img
        src="https://brandbridge-exports.lovable.app/assets/topclass-hero-C3wKyO_l.jpg"
        alt="Top Class sauces"
        class="w-full h-full object-cover opacity-25"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-brand-dark/80 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-28">
      <nav class="flex items-center gap-2 text-white/40 text-xs font-body mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/topclass" class="hover:text-white transition-colors">Top Class</a>
        <span>/</span>
        <span class="text-white/70">Sauces & Condiments</span>
      </nav>
      <div class="animate-fade-up inline-flex items-center gap-2 bg-brand-primary/20 border border-brand-primary/40 text-brand-primary text-xs font-body font-semibold uppercase tracking-widest px-4 py-2 rounded-full mb-5">
        Top Class
      </div>
      <h1 class="animate-fade-up animate-fade-up-delay-1 font-display font-bold text-white text-4xl sm:text-5xl lg:text-6xl max-w-2xl leading-tight mb-4">
        Sauces & Condiments
      </h1>
      <p class="animate-fade-up animate-fade-up-delay-2 font-body text-white/70 text-base sm:text-lg max-w-xl leading-relaxed mb-8">
        Six signature sauces in six pack sizes — from single-serve sachets to 5L bulk. Consistent flavour, every batch.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="#inquiry" class="inline-flex items-center gap-2 bg-brand-primary hover:bg-amber-600 text-white font-body font-semibold text-sm px-7 py-3.5 rounded-full transition-all hover:scale-105">
          Request Sample / Quote
        </a>
        <a href="/topclass" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-body font-medium text-sm px-7 py-3.5 rounded-full transition-all">
          ← Back to Catalogue
        </a>
      </div>
    </div>
  </section>

  <!-- PACK SIZES STRIP -->
  <section class="bg-brand-primary/10 border-y border-brand-primary/20 py-5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-center gap-3">
        <span class="font-body text-xs text-brand-muted font-semibold uppercase tracking-wider mr-2">Available in:</span>
        {packSizes.map(size => (
          <span class="bg-white text-brand-dark text-xs font-body font-medium px-3 py-1.5 rounded-full border border-stone-200 shadow-sm">{size}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- PRODUCTS GRID -->
  <section class="py-20 bg-brand-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-brand-dark text-3xl sm:text-4xl mb-3">6 Signature Sauces</h2>
        <p class="font-body text-brand-muted text-base max-w-xl mx-auto">
          Every sauce crafted for consistent flavour profile across bulk production batches.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {sauces.map(sauce => (
          <div class={`bg-gradient-to-br ${sauce.color} border ${sauce.border} rounded-2xl p-7 hover:shadow-md hover:-translate-y-0.5 transition-all`}>
            <h3 class="font-display font-bold text-brand-dark text-xl mb-2">{sauce.name}</h3>
            <p class="font-body text-brand-muted text-sm leading-relaxed mb-4">{sauce.desc}</p>
            <div class="flex flex-wrap gap-1.5">
              {sauce.packs.map(p => (
                <span class="bg-white/70 text-brand-dark text-xs font-body font-medium px-2.5 py-1 rounded-full border border-white shadow-sm">{p}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FULL TABLE -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-brand-dark text-2xl sm:text-3xl mb-8 text-center">Pack Size Matrix</h2>
      <div class="overflow-x-auto rounded-2xl border border-stone-200 shadow-sm">
        <table class="w-full font-body text-sm">
          <thead>
            <tr class="bg-brand-dark text-white">
              <th class="text-left px-5 py-4 font-semibold text-xs uppercase tracking-wider">Product</th>
              {['200g', '630g', '1kg', '5kg', 'Sachets', '5L'].map(col => (
                <th class="text-center px-3 py-4 font-semibold text-xs uppercase tracking-wider">{col}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {sauces.map((s, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-stone-50'}>
                <td class="px-5 py-4 font-semibold text-brand-dark">{s.name}</td>
                {s.packs.map(() => (
                  <td class="text-center px-3 py-4">
                    <svg class="w-4 h-4 text-green-500 mx-auto" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- INQUIRY FORM -->
  <section id="inquiry" class="py-20 bg-brand-light">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-brand-dark text-3xl sm:text-4xl mb-3">Request a Sample or Quote</h2>
        <p class="font-body text-brand-muted text-base">We respond to all inquiries within 24 hours.</p>
      </div>
      <div class="bg-white rounded-3xl shadow-sm border border-stone-100 p-8 lg:p-10">
        <InquiryForm brand="topclass" />
      </div>
    </div>
  </section>
</Layout>
