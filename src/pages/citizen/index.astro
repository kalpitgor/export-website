---
import Layout from '../../layouts/Layout.astro';
import CertBadge from '../../components/CertBadge.astro';

const onions = [
  {
    section: 'White Onion',
    items: [
      { name: 'Flakes',   img: '/white_onion_flakes.webp' },
      { name: 'Chopped',  img: '/White_onion_chopped.webp' },
      { name: 'Minced',   img: '/White_onion_minced.webp' },
      { name: 'Granules', img: '/White_onion_granules.webp' },
      { name: 'Powder',   img: '/White_powder.webp' },
    ],
  },
  {
    section: 'Red Onion',
    items: [
      { name: 'Flakes',   img: '/Red_onion_flakes.webp' },
      { name: 'Chopped',  img: '/Red_onion_chopped.webp' },
      { name: 'Minced',   img: '/Red_onion_minced.webp' },
      { name: 'Granules', img: '/Red_onion_granules.webp' },
      { name: 'Powder',   img: '/Red_onion_powder.webp' },
    ],
  },
  {
    section: 'Pink Onion',
    items: [
      { name: 'Flakes',   img: '/Dehydrated_pink_onion_flakes.webp' },
      { name: 'Chopped',  img: '/Pink_onion_chopped.webp' },
      { name: 'Minced',   img: '/Pink_onion_minced.webp' },
      { name: 'Granules', img: '/Pink_onion_granules.webp' },
      { name: 'Powder',   img: '/Pink_onion_powder.webp' },
    ],
  },
];

const garlic = [
  { name: 'Whole / Dehydrated', img: '/Dehydrated_garlic.webp' },
  { name: 'Chopped',            img: '/Dehydrated_Garlic_chopped.webp' },
  { name: 'Flakes',             img: '/Dehydrated_garlic_flakes.webp' },
  { name: 'Minced',             img: '/Dehydrated_garlic_minced.webp' },
  { name: 'Granules',           img: '/Garlic_granules.webp' },
  { name: 'Powder',             img: '/garlic_powder.webp' },
];

const powders = [
  'Coriander Leaves', 'Coriander Powder', 'Carrot Flakes', 'Carrot Powder',
  'Cabbage Flakes', 'Cabbage Powder', 'Spinach Powder', 'Curry Leaves',
  'Curry Powder', 'Tamarind Powder', 'Green Chilli Powder', 'Amchur Powder',
  'Ginger Powder', 'Beet Root Powder', 'Red Chilli Powder', 'Potato Powder',
];
---

<Layout
  title="Citizen Veg Exports — Dehydrated Vegetables, Onion, Garlic & Powders"
  description="Complete range of export-grade dehydrated onion, garlic, vegetable powders and flakes from Citizen Veg Exports, India."
>
  <!-- HERO -->
  <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-brand-dark">
      <img
        src="https://brandbridge-exports.lovable.app/assets/citizen-hero-D9gm2deQ.jpg"
        alt="Citizen Veg Exports dehydrated vegetables"
        class="w-full h-full object-cover opacity-30"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/50 to-brand-dark/80"></div>
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-24">
      <div class="animate-fade-up inline-flex items-center gap-2 bg-brand-primary/20 border border-brand-primary/40 text-brand-primary text-xs font-body font-semibold uppercase tracking-widest px-4 py-2 rounded-full mb-6">
        Citizen Veg Exports
      </div>
      <h1 class="animate-fade-up animate-fade-up-delay-1 font-display font-bold text-white text-4xl sm:text-5xl lg:text-6xl leading-tight mb-4">
        Premium dehydrated vegetables, engineered for export.
      </h1>
      <p class="animate-fade-up animate-fade-up-delay-2 font-body text-white/70 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        India's trusted manufacturer of export-grade dehydrated onions, garlic, vegetable powders and flakes — shipped to 30+ countries worldwide.
      </p>
    </div>
  </section>

  <!-- ── DEHYDRATED ONIONS ── -->
  <section id="onions" class="py-20 bg-brand-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-12">
        <div class="w-1 h-10 bg-brand-primary rounded-full"></div>
        <div>
          <h2 class="font-display font-bold text-brand-dark text-3xl sm:text-4xl">Dehydrated Onions</h2>
          <p class="font-body text-brand-muted text-sm mt-1">White, Red & Pink varieties — every cut size</p>
        </div>
      </div>

      <div class="space-y-12">
        {onions.map(group => (
          <div>
            <h3 class="font-display font-semibold text-brand-dark text-xl mb-5 flex items-center gap-2">
              <span class="w-5 h-0.5 bg-brand-primary/50 rounded"></span>
              {group.section}
            </h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
              {group.items.map(p => (
                <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-stone-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
                  <div class="aspect-[4/3] overflow-hidden bg-stone-50">
                    <img
                      src={p.img}
                      alt={`${group.section} ${p.name}`}
                      class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-3 text-center">
                    <span class="font-body font-semibold text-brand-dark text-sm">{p.name}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}

        <!-- Toasted Onion -->
        <div>
          <h3 class="font-display font-semibold text-brand-dark text-xl mb-5 flex items-center gap-2">
            <span class="w-5 h-0.5 bg-brand-primary/50 rounded"></span>
            Toasted Onion
          </h3>
          <div class="bg-gradient-to-br from-orange-50 to-amber-50 border border-amber-100 rounded-2xl p-6">
            <p class="font-body text-brand-muted text-sm mb-4">Deep caramelized notes. Perfect for instant noodles, snacks and ready meals.</p>
            <div class="flex flex-wrap gap-2">
              {['Flakes', 'Large Chopped', 'Chopped', 'Minced', 'Granules', 'Powder'].map(cut => (
                <span class="bg-white text-brand-dark text-sm font-body font-medium px-4 py-2 rounded-xl border border-amber-100">{cut}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── DEHYDRATED GARLIC ── -->
  <section id="garlic" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-12">
        <div class="w-1 h-10 bg-brand-primary rounded-full"></div>
        <div>
          <h2 class="font-display font-bold text-brand-dark text-3xl sm:text-4xl">Dehydrated Garlic</h2>
          <p class="font-body text-brand-muted text-sm mt-1">6 cut sizes — whole clove to ultra-fine powder</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {garlic.map((item, i) => (
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-stone-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <div class="aspect-[4/3] overflow-hidden bg-stone-50">
              <img
                src={item.img}
                alt={`Dehydrated Garlic ${item.name}`}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-5">
              <div class="flex items-center gap-3">
                <div class="w-7 h-7 bg-amber-50 rounded-lg flex items-center justify-center shrink-0">
                  <span class="font-display font-bold text-brand-primary text-xs">{String(i + 1).padStart(2, '0')}</span>
                </div>
                <h3 class="font-display font-semibold text-brand-dark text-lg">{item.name}</h3>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── VEGETABLE POWDERS & FLAKES ── -->
  <section id="powders" class="py-20 bg-brand-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-12">
        <div class="w-1 h-10 bg-brand-primary rounded-full"></div>
        <div>
          <h2 class="font-display font-bold text-brand-dark text-3xl sm:text-4xl">Vegetable Powders & Flakes</h2>
          <p class="font-body text-brand-muted text-sm mt-1">16+ products — colour-stable, aroma-rich and export-grade</p>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {powders.map(item => (
          <div class="bg-white border border-stone-100 rounded-2xl p-5 text-center hover:shadow-md hover:-translate-y-0.5 hover:border-brand-primary/30 transition-all">
            <div class="w-10 h-10 bg-amber-50 rounded-xl mx-auto mb-3 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375"/>
              </svg>
            </div>
            <span class="font-body font-semibold text-brand-dark text-sm">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CERTIFICATIONS -->
  <section class="py-16 bg-brand-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-brand-dark text-2xl sm:text-3xl">Certified for international trade</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        <CertBadge name="ISO 22000" subtitle="Food Safety Mgmt." />
        <CertBadge name="FSSAI" subtitle="India Food Safety" />
        <CertBadge name="HACCP" subtitle="Hazard Analysis" />
        <CertBadge name="APEDA" subtitle="Agricultural Export" />
        <CertBadge name="FDA" subtitle="US Compliance" />
        <CertBadge name="GMP" subtitle="Good Mfg. Practice" />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-brand-dark text-white text-center">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-3xl sm:text-4xl mb-4">Ready to place an order?</h2>
      <p class="font-body text-white/60 text-base mb-8">Get samples, pricing and freight terms within 24 hours.</p>
      <a
        href="/citizen/contact"
        class="inline-flex items-center gap-2 bg-brand-primary hover:bg-amber-600 text-white font-body font-semibold px-8 py-4 rounded-full transition-all hover:scale-105"
      >
        Send Export Inquiry
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>
</Layout>
