---
import Layout from '../../layouts/Layout.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import CertBadge from '../../components/CertBadge.astro';

// All products flat — image where available, label-only for powders
const products = [
  // ── White Onion ──
  { name: 'White Onion Flakes',    label: 'White Onion',  img: '/white_onion_flakes.webp' },
  { name: 'White Onion Chopped',   label: 'White Onion',  img: '/White_onion_chopped.webp' },
  { name: 'White Onion Minced',    label: 'White Onion',  img: '/White_onion_minced.webp' },
  { name: 'White Onion Granules',  label: 'White Onion',  img: '/White_onion_granules.webp' },
  { name: 'White Onion Powder',    label: 'White Onion',  img: '/White_powder.webp' },
  // ── Red Onion ──
  { name: 'Red Onion Flakes',      label: 'Red Onion',    img: '/Red_onion_flakes.webp' },
  { name: 'Red Onion Chopped',     label: 'Red Onion',    img: '/Red_onion_chopped.webp' },
  { name: 'Red Onion Minced',      label: 'Red Onion',    img: '/Red_onion_minced.webp' },
  { name: 'Red Onion Granules',    label: 'Red Onion',    img: '/Red_onion_granules.webp' },
  { name: 'Red Onion Powder',      label: 'Red Onion',    img: '/Red_onion_powder.webp' },
  // ── Pink Onion ──
  { name: 'Pink Onion Flakes',     label: 'Pink Onion',   img: '/Dehydrated_pink_onion_flakes.webp' },
  { name: 'Pink Onion Chopped',    label: 'Pink Onion',   img: '/Pink_onion_chopped.webp' },
  { name: 'Pink Onion Minced',     label: 'Pink Onion',   img: '/Pink_onion_minced.webp' },
  { name: 'Pink Onion Granules',   label: 'Pink Onion',   img: '/Pink_onion_granules.webp' },
  { name: 'Pink Onion Powder',     label: 'Pink Onion',   img: '/Pink_onion_powder.webp' },
  // ── Garlic ──
  { name: 'Garlic Whole',          label: 'Garlic',       img: '/Dehydrated_garlic.webp' },
  { name: 'Garlic Chopped',        label: 'Garlic',       img: '/Dehydrated_Garlic_chopped.webp' },
  { name: 'Garlic Flakes',         label: 'Garlic',       img: '/Dehydrated_garlic_flakes.webp' },
  { name: 'Garlic Minced',         label: 'Garlic',       img: '/Dehydrated_garlic_minced.webp' },
  { name: 'Garlic Granules',       label: 'Garlic',       img: '/Garlic_granules.webp' },
  { name: 'Garlic Powder',         label: 'Garlic',       img: '/garlic_powder.webp' },
];

const powders = [
  'Coriander Leaves', 'Coriander Powder', 'Carrot Flakes', 'Carrot Powder',
  'Cabbage Flakes', 'Cabbage Powder', 'Spinach Powder', 'Curry Leaves',
  'Curry Powder', 'Tamarind Powder', 'Green Chilli Powder', 'Amchur Powder',
  'Ginger Powder', 'Beet Root Powder', 'Red Chilli Powder', 'Potato Powder',
];

const toastedCuts = ['Flakes', 'Large Chopped', 'Chopped', 'Minced', 'Granules', 'Powder'];

const specs = [
  { label: 'Moisture',   value: '≤5%' },
  { label: 'Shelf Life', value: '24 months' },
  { label: 'SKUs',       value: '200+' },
  { label: 'Packaging',  value: 'HDPE / Drums' },
  { label: 'Compliance', value: 'FSSAI, FDA, HACCP' },
  { label: 'Min. Order', value: '500 kg' },
];
---

<Layout
  title="Products — Citizen Foods"
  description="Export-grade dehydrated onions, garlic, vegetable powders and flakes from Citizen Foods, India."
>
  <!-- HERO -->
  <section class="relative min-h-[50vh] flex items-center overflow-hidden bg-brand-dark">
    <div class="absolute inset-0 bg-gradient-to-r from-brand-dark to-brand-dark/60"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-28">
      <nav class="flex items-center gap-2 text-white/40 text-xs font-body mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/citizen" class="hover:text-white transition-colors">Citizen Foods</a>
        <span>/</span>
        <span class="text-white/70">Products</span>
      </nav>
      <div class="animate-fade-up inline-flex items-center gap-2 bg-brand-primary/20 border border-brand-primary/40 text-brand-primary text-xs font-body font-semibold uppercase tracking-widest px-4 py-2 rounded-full mb-5">
        Citizen Foods
      </div>
      <h1 class="animate-fade-up animate-fade-up-delay-1 font-display font-bold text-white text-4xl sm:text-5xl lg:text-6xl max-w-2xl leading-tight mb-4">
        Our Products
      </h1>
      <p class="animate-fade-up animate-fade-up-delay-2 font-body text-white/70 text-base sm:text-lg max-w-xl leading-relaxed mb-8">
        Dehydrated onions, garlic and vegetable powders — precision-dried for consistent colour, aroma and moisture across every export shipment.
      </p>
      <a href="#inquiry" class="inline-flex items-center gap-2 bg-brand-primary hover:bg-amber-600 text-white font-body font-semibold text-sm px-7 py-3.5 rounded-full transition-all hover:scale-105">
        Request Sample / Quote
      </a>
    </div>
  </section>

  <!-- SPECS STRIP -->
  <section class="bg-brand-primary/10 border-y border-brand-primary/20 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {specs.map(s => (
          <div class="text-center">
            <div class="font-display font-bold text-brand-dark text-base">{s.value}</div>
            <div class="font-body text-brand-muted text-xs mt-0.5">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ALL PRODUCTS GRID -->
  <section class="py-20 bg-brand-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-brand-dark text-3xl sm:text-4xl mb-3">Complete Product Range</h2>
        <p class="font-body text-brand-muted text-base max-w-xl mx-auto">
          Every product precision-processed from fresh, locally-sourced Indian produce.
        </p>
      </div>

      <!-- Image product grid (onions + garlic) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 mb-10">
        {products.map(p => (
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-stone-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <div class="aspect-square overflow-hidden bg-stone-50">
              <img
                src={p.img}
                alt={p.name}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="px-3 py-3">
              <span class="block font-body font-semibold text-brand-dark text-sm leading-snug">{p.name}</span>
              <span class="inline-block mt-1 text-xs font-body text-white bg-brand-primary/80 px-2 py-0.5 rounded-full">{p.label}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Toasted Onion (no images) -->
      <div class="bg-gradient-to-br from-orange-50 to-amber-50 border border-amber-100 rounded-2xl p-6 mb-10">
        <div class="flex items-center gap-2 mb-3">
          <span class="font-display font-bold text-brand-dark text-lg">Toasted Onion</span>
          <span class="text-xs font-body bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full">6 cuts</span>
        </div>
        <p class="font-body text-brand-muted text-sm mb-4">Deep caramelized notes. Perfect for instant noodles, snacks and ready meals.</p>
        <div class="flex flex-wrap gap-2">
          {toastedCuts.map(cut => (
            <span class="bg-white text-brand-dark text-sm font-body font-medium px-4 py-2 rounded-xl border border-amber-100">{cut}</span>
          ))}
        </div>
      </div>

      <!-- Vegetable Powders & Flakes (no images) -->
      <div class="bg-white border border-stone-100 rounded-2xl p-6">
        <div class="flex items-center gap-2 mb-5">
          <span class="font-display font-bold text-brand-dark text-lg">Vegetable Powders & Flakes</span>
          <span class="text-xs font-body bg-stone-100 text-stone-600 px-2 py-0.5 rounded-full">16+ products</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          {powders.map(item => (
            <div class="bg-brand-light border border-stone-100 rounded-xl px-4 py-3 text-center hover:border-brand-primary/30 hover:bg-amber-50/50 transition-all">
              <span class="font-body text-sm font-medium text-brand-dark">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CERTIFICATIONS -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-brand-dark text-2xl sm:text-3xl">Certified for international trade</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        <CertBadge name="ISO 22000" subtitle="Food Safety Mgmt." />
        <CertBadge name="FSSAI" subtitle="India Food Safety" />
        <CertBadge name="HACCP" subtitle="Hazard Analysis" />
        <CertBadge name="APEDA" subtitle="Agricultural Export" />
        <CertBadge name="FDA" subtitle="US Compliance" />
        <CertBadge name="GMP" subtitle="Good Mfg. Practice" />
      </div>
    </div>
  </section>

  <!-- INQUIRY -->
  <section id="inquiry" class="py-20 bg-brand-light">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-brand-dark text-3xl sm:text-4xl mb-3">Request a Sample or Quote</h2>
        <p class="font-body text-brand-muted text-base">We respond to all export inquiries within 24 hours.</p>
      </div>
      <div class="bg-white rounded-3xl shadow-sm border border-stone-100 p-8 lg:p-10">
        <InquiryForm brand="citizen" />
      </div>
    </div>
  </section>
</Layout>
