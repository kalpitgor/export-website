---
import Layout from '../../layouts/Layout.astro';
import InquiryForm from '../../components/InquiryForm.astro';

const varieties = [
  {
    type: 'White Onion',
    color: 'from-amber-50 to-yellow-50',
    border: 'border-amber-100',
    description: 'Mild, sweet flavour profile. Preferred for soups, snacks and seasoning blends.',
    heroImage: '/Dehydrated_white_onion.webp',
    products: [
      { name: 'Flakes',    img: '/white_onion_flakes.webp' },
      { name: 'Chopped',   img: '/White_onion_chopped.webp' },
      { name: 'Minced',    img: '/White_onion_minced.webp' },
      { name: 'Granules',  img: '/White_onion_granules.webp' },
      { name: 'Powder',    img: '/White_powder.webp' },
    ],
  },
  {
    type: 'Red Onion',
    color: 'from-rose-50 to-pink-50',
    border: 'border-rose-100',
    description: 'Rich colour, pungent aroma. Ideal for flavour-forward applications.',
    heroImage: '/Dehydrated_red_onion.webp',
    products: [
      { name: 'Flakes',    img: '/Red_onion_flakes.webp' },
      { name: 'Chopped',   img: '/Red_onion_chopped.webp' },
      { name: 'Minced',    img: '/Red_onion_minced.webp' },
      { name: 'Granules',  img: '/Red_onion_granules.webp' },
      { name: 'Powder',    img: '/Red_onion_powder.webp' },
    ],
  },
  {
    type: 'Pink Onion',
    color: 'from-pink-50 to-rose-50',
    border: 'border-pink-100',
    description: 'Delicate balance of sweetness and bite. High-value export variety.',
    heroImage: '/Dehydrated_pink.webp',
    products: [
      { name: 'Flakes',    img: '/Dehydrated_pink_onion_flakes.webp' },
      { name: 'Chopped',   img: '/Pink_onion_chopped.webp' },
      { name: 'Minced',    img: '/Pink_onion_minced.webp' },
      { name: 'Granules',  img: '/Pink_onion_granules.webp' },
      { name: 'Powder',    img: '/Pink_onion_powder.webp' },
    ],
  },
  {
    type: 'Toasted Onion',
    color: 'from-orange-50 to-amber-50',
    border: 'border-orange-100',
    description: 'Deep caramelized notes. Perfect for instant noodles, snacks and ready meals.',
    heroImage: null,
    products: [
      { name: 'Flakes',         img: null },
      { name: 'Large Chopped',  img: null },
      { name: 'Chopped',        img: null },
      { name: 'Minced',         img: null },
      { name: 'Granules',       img: null },
      { name: 'Powder',         img: null },
    ],
  },
];

const specs = [
  { label: 'Moisture',    value: '≤5%' },
  { label: 'Color',       value: 'Natural' },
  { label: 'Shelf Life',  value: '24 months' },
  { label: 'Packaging',   value: 'HDPE / Drums' },
  { label: 'Compliance',  value: 'FSSAI, FDA, HACCP' },
  { label: 'Min. Order',  value: '1 MT' },
];
---

<Layout
  title="Dehydrated Onion Products — Citizen Foods"
  description="White, Red, Pink & Toasted dehydrated onions in all cut sizes. Export-grade quality from Citizen Foods, India."
>
  <!-- HERO -->
  <section class="relative min-h-[50vh] flex items-center overflow-hidden bg-brand-dark">
    <div class="absolute inset-0 bg-gradient-to-r from-brand-dark to-brand-dark/60"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-28">
      <nav class="flex items-center gap-2 text-white/40 text-xs font-body mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/citizen" class="hover:text-white transition-colors">Citizen Foods</a>
        <span>/</span>
        <span class="text-white/70">Dehydrated Onions</span>
      </nav>
      <div class="animate-fade-up inline-flex items-center gap-2 bg-brand-primary/20 border border-brand-primary/40 text-brand-primary text-xs font-body font-semibold uppercase tracking-widest px-4 py-2 rounded-full mb-5">
        Citizen Foods
      </div>
      <h1 class="animate-fade-up animate-fade-up-delay-1 font-display font-bold text-white text-4xl sm:text-5xl lg:text-6xl max-w-2xl leading-tight mb-4">
        Dehydrated Onion Products
      </h1>
      <p class="animate-fade-up animate-fade-up-delay-2 font-body text-white/70 text-base sm:text-lg max-w-xl leading-relaxed mb-8">
        White, Red, Pink & Toasted onions in all cut sizes. Precision-dried for consistent colour, aroma and moisture across every export shipment.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="#inquiry" class="inline-flex items-center gap-2 bg-brand-primary hover:bg-amber-600 text-white font-body font-semibold text-sm px-7 py-3.5 rounded-full transition-all hover:scale-105">
          Request Sample / Quote
        </a>
        <a href="/citizen" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-body font-medium text-sm px-7 py-3.5 rounded-full transition-all">
          ← Back to Catalogue
        </a>
      </div>
    </div>
  </section>

  <!-- SPECS STRIP -->
  <section class="bg-brand-primary/10 border-y border-brand-primary/20 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {specs.map(s => (
          <div class="text-center">
            <div class="font-display font-bold text-brand-dark text-base">{s.value}</div>
            <div class="font-body text-brand-muted text-xs mt-0.5">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VARIETIES WITH PRODUCT IMAGES -->
  <section class="py-20 bg-brand-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="font-display font-bold text-brand-dark text-3xl sm:text-4xl mb-3">4 Varieties. Every Cut Size.</h2>
        <p class="font-body text-brand-muted text-base max-w-xl mx-auto">Every variety available in the cuts your buyers need.</p>
      </div>

      <div class="space-y-16">
        {varieties.map(v => (
          <div class={`bg-gradient-to-br ${v.color} border ${v.border} rounded-3xl p-7 lg:p-10`}>
            <!-- Variety header -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-4 mb-8">
              {v.heroImage ? (
                <div class="w-24 h-24 rounded-2xl overflow-hidden shrink-0 shadow-md border border-white/60">
                  <img src={v.heroImage} alt={v.type} class="w-full h-full object-cover" loading="lazy" />
                </div>
              ) : (
                <div class="w-24 h-24 rounded-2xl bg-white/50 shrink-0 flex items-center justify-center border border-white/60">
                  <svg class="w-8 h-8 text-brand-primary/40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909"/>
                  </svg>
                </div>
              )}
              <div>
                <h3 class="font-display font-bold text-brand-dark text-2xl sm:text-3xl mb-1">{v.type}</h3>
                <p class="font-body text-brand-muted text-sm leading-relaxed max-w-xl">{v.description}</p>
              </div>
            </div>

            <!-- Product image grid -->
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
              {v.products.map(p => (
                <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-white/80 hover:shadow-md hover:-translate-y-1 transition-all">
                  {p.img ? (
                    <div class="aspect-square overflow-hidden bg-stone-50">
                      <img
                        src={p.img}
                        alt={`${v.type} ${p.name}`}
                        class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                      />
                    </div>
                  ) : (
                    <div class="aspect-square bg-stone-100 flex items-center justify-center">
                      <svg class="w-8 h-8 text-stone-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909"/>
                      </svg>
                    </div>
                  )}
                  <div class="p-3 text-center">
                    <span class="font-body font-semibold text-brand-dark text-sm">{p.name}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FULL TABLE -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-brand-dark text-2xl sm:text-3xl mb-8 text-center">Full Product Matrix</h2>
      <div class="overflow-x-auto rounded-2xl border border-stone-200 shadow-sm">
        <table class="w-full font-body text-sm">
          <thead>
            <tr class="bg-brand-dark text-white">
              <th class="text-left px-5 py-4 font-semibold text-xs uppercase tracking-wider">Variety</th>
              {['Flakes / Slices', 'Kibbled (15–35mm)', 'Chopped / Large Chopped', 'Minced', 'Granules', 'Powder'].map(col => (
                <th class="text-center px-3 py-4 font-semibold text-xs uppercase tracking-wider">{col}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {[
              { t: 'White Onion',   v: [true, true, true, true, true, true] },
              { t: 'Red Onion',     v: [true, true, true, true, true, true] },
              { t: 'Pink Onion',    v: [true, true, true, true, true, true] },
              { t: 'Toasted Onion', v: [true, true, true, true, true, true] },
            ].map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-stone-50'}>
                <td class="px-5 py-4 font-semibold text-brand-dark">{row.t}</td>
                {row.v.map(has => (
                  <td class="text-center px-3 py-4">
                    {has ? (
                      <svg class="w-4 h-4 text-green-500 mx-auto" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                      </svg>
                    ) : (
                      <span class="text-stone-300">—</span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- INQUIRY FORM -->
  <section id="inquiry" class="py-20 bg-brand-light">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-brand-dark text-3xl sm:text-4xl mb-3">Request a Sample or Quote</h2>
        <p class="font-body text-brand-muted text-base">We respond to all export inquiries within 24 hours.</p>
      </div>
      <div class="bg-white rounded-3xl shadow-sm border border-stone-100 p-8 lg:p-10">
        <InquiryForm brand="citizen" />
      </div>
    </div>
  </section>
</Layout>
