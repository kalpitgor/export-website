---
import Layout from '../../layouts/Layout.astro';
import StatCounter from '../../components/StatCounter.astro';
import CertBadge from '../../components/CertBadge.astro';

const pillars = [
  {
    title: 'Naturally Sourced',
    desc: 'Direct farm partnerships, full traceability and seasonality planning ensure we always have the freshest raw material.',
    icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Modern Manufacturing',
    desc: 'Multi-stage dehydration, precision milling and automated sieving lines ensure uniform particle size and colour across every batch.',
    icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    title: 'Food-Safety First',
    desc: 'GMP, HACCP, ISO 22000 protocols enforced at every step. On-site QC lab with chemical, microbiological and sensory testing.',
    icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  },
  {
    title: 'Built for Export',
    desc: 'Container-load capacity with port-optimised logistics, custom packaging options and full export documentation support.',
    icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  },
];
---

<Layout
  title="About Citizen Veg Exports — Dehydrated Vegetables & Spice Exporter"
  description="25+ years of expertise in dehydrated onion, garlic, vegetable powders and flakes. ISO 22000, FSSAI, HACCP certified manufacturer in India."
>
  <!-- HERO -->
  <section class="relative min-h-[60vh] flex items-center overflow-hidden bg-brand-dark">
    <div class="absolute inset-0">
      <img
        src="https://brandbridge-exports.lovable.app/assets/facility-CTZknzzJ.jpg"
        alt="Citizen Veg Exports manufacturing facility"
        class="w-full h-full object-cover opacity-25"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-brand-dark/80 to-brand-dark/40"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-28">
      <nav class="flex items-center gap-2 text-white/40 text-xs font-body mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/citizen" class="hover:text-white transition-colors">Citizen Veg Exports</a>
        <span>/</span>
        <span class="text-white/70">About</span>
      </nav>
      <div class="animate-fade-up inline-flex items-center gap-2 bg-brand-primary/20 border border-brand-primary/40 text-brand-primary text-xs font-body font-semibold uppercase tracking-widest px-4 py-2 rounded-full mb-5">
        About Citizen Veg Exports
      </div>
      <h1 class="animate-fade-up animate-fade-up-delay-1 font-display font-bold text-white text-4xl sm:text-5xl lg:text-6xl max-w-2xl leading-tight mb-4">
        Made in India. Trusted worldwide.
      </h1>
      <p class="animate-fade-up animate-fade-up-delay-2 font-body text-white/70 text-base sm:text-lg max-w-2xl leading-relaxed">
        Citizen Veg Exports is India's trusted dehydrated vegetables division — specialising in premium onion, garlic, spice powder and vegetable flake exports. We operate a modern, hygienic facility that delivers consistent quality at bulk export capacity.
      </p>
    </div>
  </section>

  <!-- STATS -->
  <section class="bg-brand-dark py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        <StatCounter value="30+" label="Export Countries" />
        <StatCounter value="25+" label="Years of Expertise" />
        <StatCounter value="200+" label="Dehydrated SKUs" />
        <StatCounter value="5000+" label="MT Annual Capacity" />
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <div class="inline-flex items-center gap-2 text-brand-primary text-xs font-body font-semibold uppercase tracking-widest mb-4">
            <span class="w-8 h-px bg-brand-primary"></span>
            Our Story
          </div>
          <h2 class="font-display font-bold text-brand-dark text-3xl sm:text-4xl mb-6 leading-tight">
            25 years of building export trust.
          </h2>
          <div class="space-y-4 font-body text-brand-muted text-base leading-relaxed">
            <p>
              Citizen Veg Exports began with a single mission: to bring the best of India's agricultural abundance to kitchens and food manufacturers worldwide. Over 25 years, we have grown from a regional supplier into a globally recognised export brand.
            </p>
            <p>
              Our facility in Gujarat operates multi-stage dehydration lines, precision milling units and automated quality-control systems — all under one roof. This vertical integration gives us full control over quality from raw material sourcing to the final sealed container.
            </p>
            <p>
              Today, we supply dehydrated onions, garlic, vegetable powders and flakes to food manufacturers, importers and distributors across 30+ countries. Our export documentation, packaging flexibility and responsive team make us the partner of choice for serious global buyers.
            </p>
          </div>
        </div>
        <div class="relative">
          <div class="aspect-[4/3] rounded-3xl overflow-hidden shadow-2xl">
            <img
              src="https://brandbridge-exports.lovable.app/assets/facility-CTZknzzJ.jpg"
              alt="Citizen Veg Exports facility"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="absolute -bottom-4 -right-4 bg-brand-primary text-white px-5 py-3 rounded-2xl shadow-lg">
            <p class="font-display font-bold text-2xl">25+</p>
            <p class="font-body text-xs font-medium text-white/80">Years in export</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="py-20 bg-brand-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-brand-dark text-3xl sm:text-4xl mb-3">How we deliver quality</h2>
        <p class="font-body text-brand-muted text-base max-w-xl mx-auto">
          Four pillars that define every batch we produce and ship.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {pillars.map(p => (
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-stone-100 hover:shadow-md transition-all">
            <div class="w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={p.icon}/>
              </svg>
            </div>
            <h3 class="font-display font-bold text-brand-dark text-xl mb-2">{p.title}</h3>
            <p class="font-body text-brand-muted text-sm leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CERTIFICATIONS -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-brand-dark text-2xl sm:text-3xl mb-3">Certified for global trade</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        <CertBadge name="ISO 22000:2018" subtitle="Food Safety Mgmt." />
        <CertBadge name="FSSAI" subtitle="India Food Safety" />
        <CertBadge name="HACCP" subtitle="Hazard Analysis" />
        <CertBadge name="APEDA" subtitle="Agricultural Export" />
        <CertBadge name="FDA" subtitle="US Compliance" />
        <CertBadge name="GMP" subtitle="Good Mfg. Practice" />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gradient-to-br from-brand-accent to-brand-primary text-white text-center">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-3xl sm:text-4xl mb-4">Partner with Citizen Veg Exports</h2>
      <p class="font-body text-white/80 text-base mb-8">Send us your product requirements and receive samples, pricing and freight terms within 24 hours.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/citizen/contact" class="inline-flex items-center gap-2 bg-white hover:bg-amber-50 text-brand-primary font-body font-bold text-sm px-8 py-4 rounded-full transition-all hover:scale-105 shadow-xl">
          Send Export Inquiry
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="/citizen" class="inline-flex items-center gap-2 bg-white/15 hover:bg-white/25 border border-white/30 text-white font-body font-semibold text-sm px-8 py-4 rounded-full transition-all hover:scale-105">
          View Products
        </a>
      </div>
    </div>
  </section>
</Layout>
