---
import Layout from '../../layouts/Layout.astro';
import InquiryForm from '../../components/InquiryForm.astro';

const products = [
  { name: 'Coriander Leaves', type: 'Flakes', color: 'from-green-50 to-emerald-50', border: 'border-green-100' },
  { name: 'Coriander Powder', type: 'Powder', color: 'from-lime-50 to-green-50', border: 'border-lime-100' },
  { name: 'Carrot Flakes', type: 'Flakes', color: 'from-orange-50 to-amber-50', border: 'border-orange-100' },
  { name: 'Carrot Powder', type: 'Powder', color: 'from-amber-50 to-orange-50', border: 'border-amber-100' },
  { name: 'Cabbage Flakes', type: 'Flakes', color: 'from-lime-50 to-yellow-50', border: 'border-lime-100' },
  { name: 'Cabbage Powder', type: 'Powder', color: 'from-yellow-50 to-lime-50', border: 'border-yellow-100' },
  { name: 'Spinach Powder', type: 'Powder', color: 'from-emerald-50 to-green-50', border: 'border-emerald-100' },
  { name: 'Curry Leaves', type: 'Flakes', color: 'from-green-50 to-teal-50', border: 'border-green-100' },
  { name: 'Curry Powder', type: 'Powder', color: 'from-yellow-50 to-amber-50', border: 'border-yellow-100' },
  { name: 'Tamarind Powder', type: 'Powder', color: 'from-amber-50 to-yellow-50', border: 'border-amber-100' },
  { name: 'Green Chilli Powder', type: 'Powder', color: 'from-green-50 to-lime-50', border: 'border-green-100' },
  { name: 'Amchur Powder', type: 'Powder', color: 'from-yellow-50 to-orange-50', border: 'border-yellow-100' },
  { name: 'Ginger Powder', type: 'Powder', color: 'from-amber-50 to-yellow-50', border: 'border-amber-100' },
  { name: 'Beet Root Powder', type: 'Powder', color: 'from-rose-50 to-pink-50', border: 'border-rose-100' },
  { name: 'Red Chilli Powder', type: 'Powder', color: 'from-red-50 to-rose-50', border: 'border-red-100' },
  { name: 'Potato Powder', type: 'Powder', color: 'from-stone-50 to-amber-50', border: 'border-stone-100' },
];

const specs = [
  { label: 'Moisture', value: '≤5%' },
  { label: 'Shelf Life', value: '18–24 months' },
  { label: 'SKUs', value: '16+' },
  { label: 'Pack Sizes', value: 'Custom' },
  { label: 'Compliance', value: 'FSSAI, FDA' },
  { label: 'Min. Order', value: '500 kg' },
];
---

<Layout
  title="Vegetable Powders & Flakes — Citizen Foods"
  description="16+ dehydrated vegetable powders and flakes including coriander, carrot, spinach, ginger, chilli and more. Export-grade from Citizen Foods."
>
  <!-- HERO -->
  <section class="relative min-h-[50vh] flex items-center overflow-hidden bg-brand-dark">
    <div class="absolute inset-0 bg-gradient-to-r from-brand-dark to-brand-dark/60"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-28">
      <nav class="flex items-center gap-2 text-white/40 text-xs font-body mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/citizen" class="hover:text-white transition-colors">Citizen Foods</a>
        <span>/</span>
        <span class="text-white/70">Powders & Flakes</span>
      </nav>
      <div class="animate-fade-up inline-flex items-center gap-2 bg-brand-primary/20 border border-brand-primary/40 text-brand-primary text-xs font-body font-semibold uppercase tracking-widest px-4 py-2 rounded-full mb-5">
        Citizen Foods
      </div>
      <h1 class="animate-fade-up animate-fade-up-delay-1 font-display font-bold text-white text-4xl sm:text-5xl lg:text-6xl max-w-2xl leading-tight mb-4">
        Vegetable Powders & Flakes
      </h1>
      <p class="animate-fade-up animate-fade-up-delay-2 font-body text-white/70 text-base sm:text-lg max-w-xl leading-relaxed mb-8">
        16+ dehydrated vegetable products — colour-stable, aroma-rich and functional. Complete export-grade range from India's trusted manufacturer.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="#inquiry" class="inline-flex items-center gap-2 bg-brand-primary hover:bg-amber-600 text-white font-body font-semibold text-sm px-7 py-3.5 rounded-full transition-all hover:scale-105">
          Request Sample / Quote
        </a>
        <a href="/citizen" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-body font-medium text-sm px-7 py-3.5 rounded-full transition-all">
          ← Back to Catalogue
        </a>
      </div>
    </div>
  </section>

  <!-- SPECS STRIP -->
  <section class="bg-brand-primary/10 border-y border-brand-primary/20 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {specs.map(s => (
          <div class="text-center">
            <div class="font-display font-bold text-brand-dark text-base">{s.value}</div>
            <div class="font-body text-brand-muted text-xs mt-0.5">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRODUCT GRID -->
  <section class="py-20 bg-brand-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-brand-dark text-3xl sm:text-4xl mb-3">16 Products. Export Ready.</h2>
        <p class="font-body text-brand-muted text-base max-w-xl mx-auto">
          Every item precision-dried, milled and packed for international shipment.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {products.map(p => (
          <div class={`bg-gradient-to-br ${p.color} border ${p.border} rounded-2xl p-5 text-center hover:shadow-md hover:-translate-y-0.5 transition-all`}>
            <div class="w-10 h-10 bg-white rounded-xl mx-auto mb-3 flex items-center justify-center shadow-sm">
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 2.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125"/>
              </svg>
            </div>
            <h3 class="font-body font-semibold text-brand-dark text-sm leading-snug mb-1">{p.name}</h3>
            <span class="text-xs font-body text-brand-muted">{p.type}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- APPLICATIONS -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-brand-dark text-2xl sm:text-3xl mb-3">Where our powders are used</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {['Soups & Stocks', 'Snack Seasonings', 'Ready Meals', 'Spice Blends', 'Baby Food', 'Health Supplements'].map(app => (
          <div class="bg-stone-50 border border-stone-200 rounded-xl p-4 text-center">
            <span class="font-body text-sm font-medium text-brand-dark">{app}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INQUIRY FORM -->
  <section id="inquiry" class="py-20 bg-brand-light">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display font-bold text-brand-dark text-3xl sm:text-4xl mb-3">Request a Sample or Quote</h2>
        <p class="font-body text-brand-muted text-base">We respond to all export inquiries within 24 hours.</p>
      </div>
      <div class="bg-white rounded-3xl shadow-sm border border-stone-100 p-8 lg:p-10">
        <InquiryForm brand="citizen" />
      </div>
    </div>
  </section>
</Layout>
