---
import Layout from '../../layouts/Layout.astro';
import InquiryForm from '../../components/InquiryForm.astro';

const contactItems = [
  {
    label: 'Email',
    value: 'info@citizenvegexports.com',
    href: 'mailto:info@citizenvegexports.com',
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
  {
    label: 'Phone',
    value: '+91 97146 49292',
    href: 'tel:+919714649292',
    icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
  },
  {
    label: 'WhatsApp',
    value: 'Chat on WhatsApp',
    href: 'https://wa.me/919512309292',
    icon: 'M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z',
  },
  {
    label: 'Address',
    value: 'Manufacturing Unit, Gujarat, India',
    href: null,
    icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
  },
];
---

<Layout
  title="Contact Citizen Veg Exports — Export Inquiry"
  description="Get in touch with Citizen Veg Exports for export inquiries. Samples, pricing and freight terms within 24 hours."
>
  <!-- HERO -->
  <section class="bg-brand-dark relative overflow-hidden py-28">
    <div class="absolute inset-0 opacity-5">
      <div class="w-full h-full" style="background-image: radial-gradient(circle, #D97706 1px, transparent 1px); background-size: 40px 40px;"></div>
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <nav class="flex items-center justify-center gap-2 text-white/40 text-xs font-body mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/citizen" class="hover:text-white transition-colors">Citizen Veg Exports</a>
        <span>/</span>
        <span class="text-white/70">Contact</span>
      </nav>
      <div class="animate-fade-up inline-flex items-center gap-2 bg-brand-primary/20 border border-brand-primary/40 text-brand-primary text-xs font-body font-semibold uppercase tracking-widest px-4 py-2 rounded-full mb-6">
        Contact Citizen Veg Exports
      </div>
      <h1 class="animate-fade-up animate-fade-up-delay-1 font-display font-bold text-white text-4xl sm:text-5xl lg:text-6xl leading-tight mb-4">
        Let's talk export.
      </h1>
      <p class="animate-fade-up animate-fade-up-delay-2 font-body text-white/70 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        Send us your inquiry for dehydrated onions, garlic, vegetable powders or flakes. Our export team will respond within 24 hours with samples, pricing and freight terms.
      </p>
    </div>
  </section>

  <!-- CONTACT INFO ROW -->
  <section class="py-12 bg-brand-light border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {contactItems.map(item => (
          <div class="flex items-start gap-4 bg-white rounded-2xl p-5 shadow-sm border border-stone-100">
            <div class="w-10 h-10 bg-amber-50 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon}/>
              </svg>
            </div>
            <div>
              <p class="font-body text-xs text-brand-muted font-medium uppercase tracking-wide mb-0.5">{item.label}</p>
              {item.href ? (
                <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel="noopener" class="font-body font-semibold text-brand-dark text-sm hover:text-brand-primary transition-colors">{item.value}</a>
              ) : (
                <p class="font-body font-semibold text-brand-dark text-sm">{item.value}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FORM + INFO -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16">
        <!-- Left: Info -->
        <div class="lg:col-span-2">
          <h2 class="font-display font-bold text-brand-dark text-2xl sm:text-3xl mb-4 leading-snug">
            Get pricing, samples and freight terms fast.
          </h2>
          <p class="font-body text-brand-muted text-sm leading-relaxed mb-6">
            We respond to every export inquiry within 24 hours. Fill out the form and our team will send you:
          </p>
          <ul class="space-y-3 mb-8">
            {['Product specifications & SDS sheets', 'Free sample dispatch details', 'FOB / CIF pricing based on quantity', 'Certifications pack (ISO, FSSAI, HACCP, APEDA)', 'Packaging options & lead times'].map(item => (
              <li class="flex items-start gap-2.5 font-body text-sm text-brand-dark">
                <svg class="w-4 h-4 text-brand-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>

          <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5">
            <p class="font-body text-sm font-semibold text-amber-800 mb-1">⏱ 24-hour response guarantee</p>
            <p class="font-body text-xs text-amber-700 leading-relaxed">
              Our export team is available Mon–Sat, 9am–6pm IST. Emails received on Sunday are replied the following morning.
            </p>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="lg:col-span-3">
          <div class="bg-brand-light rounded-3xl p-8 lg:p-10 border border-stone-100">
            <h3 class="font-display font-bold text-brand-dark text-xl mb-6">Export Inquiry Form</h3>
            <InquiryForm brand="citizen" />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
