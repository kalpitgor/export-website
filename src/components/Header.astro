---
const currentPath = Astro.url.pathname;

// Detect active brand from URL for SSR initial state
const isTopclassPath = currentPath.startsWith('/topclass');
const defaultBrand = isTopclassPath ? 'topclass' : 'citizen';

// Nav links — hrefs are placeholders, JS swaps them based on active brand
const citizenNav = [
  { label: 'Home',     href: '/' },
  { label: 'Products', href: '/citizen' },
  { label: 'About',    href: '/citizen/about' },
  { label: 'Contact',  href: '/citizen/contact' },
];
const topclassNav = [
  { label: 'Home',     href: '/' },
  { label: 'Products', href: '/topclass' },
  { label: 'About',    href: '/topclass/about' },
  { label: 'Contact',  href: '/topclass/contact' },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" data-header>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">

      <!-- ── Dual Logo Toggle ── -->
      <div class="flex items-center gap-2">
        <!-- Citizen Foods Logo -->
        <button
          id="logo-citizen"
          data-brand="citizen"
          aria-label="Citizen Foods"
          class="logo-btn flex items-center gap-2 px-2 py-1.5 rounded-xl transition-all duration-300 hover:bg-white/10 focus:outline-none"
        >
          <img
            src="/logo-citizen.png"
            alt="Citizen Foods"
            class="h-9 w-auto object-contain transition-all duration-300"
            id="img-citizen"
          />
        </button>

        <!-- Divider -->
        <span class="text-white/25 select-none text-xl font-thin">×</span>

        <!-- Top Class Logo -->
        <button
          id="logo-topclass"
          data-brand="topclass"
          aria-label="Top Class"
          class="logo-btn flex items-center gap-2 px-2 py-1.5 rounded-xl transition-all duration-300 hover:bg-white/10 focus:outline-none"
        >
          <img
            src="/logo-topclass.png"
            alt="Top Class"
            class="h-9 w-auto object-contain transition-all duration-300"
            id="img-topclass"
          />
        </button>
      </div>

      <!-- ── Desktop Nav ── -->
      <nav class="hidden md:flex items-center gap-7">
        {citizenNav.map(link => (
          <a
            data-nav-label={link.label}
            href={link.href}
            class={`nav-link text-sm font-body font-medium transition-colors ${
              currentPath === link.href ? 'text-brand-primary' : 'text-white/80 hover:text-white'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- ── CTA + Hamburger ── -->
      <div class="flex items-center gap-3">
        <a
          id="cta-btn"
          href="/citizen/contact"
          class="hidden md:inline-flex items-center gap-2 bg-brand-primary hover:bg-amber-600 text-white text-sm font-body font-semibold px-5 py-2.5 rounded-full transition-all hover:scale-105 active:scale-95"
        >
          Get Quote
        </a>

        <button
          id="mobile-menu-btn"
          aria-label="Toggle menu"
          class="md:hidden flex flex-col gap-1.5 p-2 rounded-md hover:bg-white/10 transition-colors"
        >
          <span class="hamburger-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
          <span class="hamburger-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
          <span class="hamburger-line block w-4 h-0.5 bg-white transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- ── Mobile Drawer ── -->
  <div
    id="mobile-menu"
    class="md:hidden max-h-0 overflow-hidden transition-all duration-300 ease-in-out bg-brand-dark/95 backdrop-blur-sm"
  >
    <nav class="flex flex-col gap-1 px-4 py-4 border-t border-white/10">
      <!-- Mobile brand switcher -->
      <div class="flex gap-2 mb-4 pb-3 border-b border-white/10">
        <button data-brand="citizen" class="mobile-brand-btn flex-1 flex items-center justify-center py-2 px-3 rounded-lg transition-all duration-200">
          <img src="/logo-citizen.png" alt="Citizen Foods" class="h-7 w-auto object-contain" id="mobile-img-citizen" />
        </button>
        <button data-brand="topclass" class="mobile-brand-btn flex-1 flex items-center justify-center py-2 px-3 rounded-lg transition-all duration-200">
          <img src="/logo-topclass.png" alt="Top Class" class="h-7 w-auto object-contain" id="mobile-img-topclass" />
        </button>
      </div>

      <!-- Mobile nav links (updated by JS) -->
      <a data-nav-label="Home"     href="/"                 class="mobile-nav-link flex items-center px-4 py-3 rounded-xl text-white/80 hover:text-white hover:bg-white/10 font-body font-medium transition-colors">Home</a>
      <a data-nav-label="Products" href="/citizen"          class="mobile-nav-link flex items-center px-4 py-3 rounded-xl text-white/80 hover:text-white hover:bg-white/10 font-body font-medium transition-colors">Products</a>
      <a data-nav-label="About"    href="/citizen/about"    class="mobile-nav-link flex items-center px-4 py-3 rounded-xl text-white/80 hover:text-white hover:bg-white/10 font-body font-medium transition-colors">About</a>
      <a data-nav-label="Contact"  href="/citizen/contact"  class="mobile-nav-link flex items-center px-4 py-3 rounded-xl text-white/80 hover:text-white hover:bg-white/10 font-body font-medium transition-colors">Contact</a>

      <a id="mobile-cta" href="/citizen/contact" class="mt-3 flex items-center justify-center bg-brand-primary hover:bg-amber-600 text-white font-body font-semibold py-3 px-6 rounded-xl transition-colors">
        Get Quote
      </a>
    </nav>
  </div>
</header>

<script>
  const header   = document.querySelector('[data-header]') as HTMLElement;
  const btn      = document.getElementById('mobile-menu-btn');
  const menu     = document.getElementById('mobile-menu');
  const lines    = document.querySelectorAll('.hamburger-line');
  let menuOpen   = false;
  const isHome   = window.location.pathname === '/';

  // Nav data per brand
  const navData: Record<string, Record<string, string>> = {
    citizen: {
      Home:     '/',
      Products: '/citizen',
      About:    '/citizen/about',
      Contact:  '/citizen/contact',
    },
    topclass: {
      Home:     '/',
      Products: '/topclass',
      About:    '/topclass/about',
      Contact:  '/topclass/contact',
    },
  };

  // Scroll backdrop
  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      header.classList.add('bg-brand-dark/95', 'backdrop-blur-md', 'shadow-xl');
    } else {
      header.classList.remove('bg-brand-dark/95', 'backdrop-blur-md', 'shadow-xl');
    }
  });

  // Mobile menu
  btn?.addEventListener('click', () => {
    menuOpen = !menuOpen;
    menu!.style.maxHeight = menuOpen ? menu!.scrollHeight + 'px' : '0';
    lines[0].classList.toggle('rotate-45',    menuOpen);
    lines[0].classList.toggle('translate-y-2', menuOpen);
    lines[1].classList.toggle('opacity-0',    menuOpen);
    lines[2].classList.toggle('-rotate-45',   menuOpen);
    lines[2].classList.toggle('-translate-y-2', menuOpen);
    lines[2].classList.toggle('!w-6',         menuOpen);
  });

  function switchBrand(brand: string) {
    const isCitizen = brand === 'citizen';

    // ── Logo color toggle ──
    // Active = full color; inactive = grayscale + dim
    const imgCitizen  = document.getElementById('img-citizen')  as HTMLImageElement;
    const imgTopclass = document.getElementById('img-topclass') as HTMLImageElement;
    const mImgCitizen  = document.getElementById('mobile-img-citizen')  as HTMLImageElement;
    const mImgTopclass = document.getElementById('mobile-img-topclass') as HTMLImageElement;

    [imgCitizen, mImgCitizen].forEach(img => {
      if (!img) return;
      img.style.filter  = isCitizen ? 'none' : 'grayscale(100%)';
      img.style.opacity = isCitizen ? '1' : '0.35';
    });
    [imgTopclass, mImgTopclass].forEach(img => {
      if (!img) return;
      img.style.filter  = isCitizen ? 'grayscale(100%)' : 'none';
      img.style.opacity = isCitizen ? '0.35' : '1';
    });

    // Active logo button: subtle background highlight
    document.getElementById('logo-citizen')?.classList.toggle('bg-white/10', isCitizen);
    document.getElementById('logo-topclass')?.classList.toggle('bg-white/10', !isCitizen);

    // Mobile brand buttons
    document.querySelectorAll('.mobile-brand-btn').forEach(el => {
      const b = (el as HTMLElement).dataset.brand;
      el.classList.toggle('bg-white/15', b === brand);
      el.classList.toggle('ring-1',      b === brand);
      el.classList.toggle('ring-white/30', b === brand);
    });

    // ── Update nav links ──
    const links = navData[brand];
    document.querySelectorAll<HTMLAnchorElement>('.nav-link, .mobile-nav-link').forEach(a => {
      const label = a.dataset.navLabel!;
      if (links[label]) a.href = links[label];
    });

    // ── CTA ──
    const ctaHref = isCitizen ? '/citizen/contact' : '/topclass/contact';
    (document.getElementById('cta-btn') as HTMLAnchorElement).href = ctaHref;
    (document.getElementById('mobile-cta') as HTMLAnchorElement).href = ctaHref;

    // ── Favicon ──
    const favicon = document.querySelector<HTMLLinkElement>('link[rel="icon"]');
    if (favicon) {
      favicon.href = isCitizen ? '/citizen-favicon.ico' : '/topclass-favicon.ico';
      favicon.type = 'image/x-icon';
    }

    // ── Homepage content toggle ──
    if (isHome) {
      document.getElementById('brand-citizen')?.classList.toggle('hidden', !isCitizen);
      document.getElementById('brand-topclass')?.classList.toggle('hidden', isCitizen);
    } else {
      // On sub-pages, logo click navigates to brand home
      // (only navigate if switching to a different brand)
      const current = sessionStorage.getItem('activeBrand') || 'citizen';
      if (brand !== current) {
        window.location.href = isCitizen ? '/citizen' : '/topclass';
      }
    }

    sessionStorage.setItem('activeBrand', brand);
  }

  // ── Wire up all brand-toggle buttons ──
  document.querySelectorAll<HTMLElement>('[data-brand]').forEach(el => {
    el.addEventListener('click', () => switchBrand(el.dataset.brand!));
  });

  // ── Init on load ──
  function initBrand() {
    let brand = sessionStorage.getItem('activeBrand') || 'citizen';
    if (window.location.pathname.startsWith('/topclass')) brand = 'topclass';
    else if (window.location.pathname.startsWith('/citizen')) brand = 'citizen';
    switchBrand(brand);
  }

  initBrand();
</script>
