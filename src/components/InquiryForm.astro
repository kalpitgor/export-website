---
interface Props {
  brand?: 'citizen' | 'topclass';
  accessKey?: string;
}

const { brand = 'citizen', accessKey = 'YOUR_WEB3FORMS_ACCESS_KEY' } = Astro.props;

const productOptions = brand === 'citizen'
  ? [
      'Dehydrated White Onion',
      'Dehydrated Red Onion',
      'Dehydrated Pink Onion',
      'Toasted Onion',
      'Dehydrated Garlic',
      'Coriander Powder/Leaves',
      'Carrot Flakes/Powder',
      'Vegetable Powders',
      'Custom Mix',
      'Other',
    ]
  : [
      'Red Chilli Sauce',
      'Green Chilli Sauce',
      'Soya Sauce',
      'Tomato Ketchup',
      'Schezwan Chutney',
      'Garlic Paste',
      'Ginger Garlic Paste',
      'Peri Peri Masala',
      'Chat Masala',
      'Other',
    ];
---

<form
  id="inquiry-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  class="space-y-5"
  novalidate
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={`Export Inquiry - ${brand === 'citizen' ? 'Citizen Veg Exports' : 'Top Class'}`} />
  <input type="hidden" name="redirect" value="false" />
  <input type="checkbox" name="botcheck" class="hidden" />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <!-- Full Name -->
    <div>
      <label class="block text-sm font-body font-semibold text-brand-dark mb-1.5" for="full-name">
        Full Name <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="full-name"
        name="full_name"
        required
        placeholder="Your full name"
        class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-white text-brand-dark font-body text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-primary/30 focus:border-brand-primary transition"
      />
    </div>

    <!-- Company -->
    <div>
      <label class="block text-sm font-body font-semibold text-brand-dark mb-1.5" for="company">
        Company <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="company"
        name="company"
        required
        placeholder="Your company name"
        class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-white text-brand-dark font-body text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-primary/30 focus:border-brand-primary transition"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <!-- Country -->
    <div>
      <label class="block text-sm font-body font-semibold text-brand-dark mb-1.5" for="country">
        Country <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="country"
        name="country"
        required
        placeholder="e.g. United States"
        class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-white text-brand-dark font-body text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-primary/30 focus:border-brand-primary transition"
      />
    </div>

    <!-- Quantity -->
    <div>
      <label class="block text-sm font-body font-semibold text-brand-dark mb-1.5" for="quantity">
        Quantity Required <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="quantity"
        name="quantity"
        required
        placeholder="e.g. 1 MT, 500 kg / month"
        class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-white text-brand-dark font-body text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-primary/30 focus:border-brand-primary transition"
      />
    </div>
  </div>

  <!-- Product of Interest -->
  <div>
    <label class="block text-sm font-body font-semibold text-brand-dark mb-1.5" for="product">
      Product of Interest <span class="text-red-500">*</span>
    </label>
    <select
      id="product"
      name="product_interest"
      required
      class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-white text-brand-dark font-body text-sm focus:outline-none focus:ring-2 focus:ring-brand-primary/30 focus:border-brand-primary transition appearance-none cursor-pointer"
    >
      <option value="" disabled selected>Select a product</option>
      {productOptions.map(opt => <option value={opt}>{opt}</option>)}
    </select>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <!-- Email -->
    <div>
      <label class="block text-sm font-body font-semibold text-brand-dark mb-1.5" for="email">
        Email <span class="text-red-500">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder="your@email.com"
        class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-white text-brand-dark font-body text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-primary/30 focus:border-brand-primary transition"
      />
    </div>

    <!-- Phone -->
    <div>
      <label class="block text-sm font-body font-semibold text-brand-dark mb-1.5" for="phone">
        Phone (with country code) <span class="text-red-500">*</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        placeholder="+1 555 000 0000"
        class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-white text-brand-dark font-body text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-primary/30 focus:border-brand-primary transition"
      />
    </div>
  </div>

  <!-- Message -->
  <div>
    <label class="block text-sm font-body font-semibold text-brand-dark mb-1.5" for="message">
      Message
    </label>
    <textarea
      id="message"
      name="message"
      rows="4"
      placeholder="Any specific requirements, certifications needed, pack sizes, or other details…"
      class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-white text-brand-dark font-body text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-primary/30 focus:border-brand-primary transition resize-none"
    ></textarea>
  </div>

  <!-- Submit -->
  <button
    type="submit"
    id="form-submit-btn"
    class="w-full sm:w-auto flex items-center justify-center gap-2 bg-brand-primary hover:bg-amber-600 text-white font-body font-semibold text-sm px-8 py-3.5 rounded-xl transition-all hover:scale-[1.02] active:scale-[0.98] min-h-[48px]"
  >
    <span id="btn-text">Send Export Inquiry</span>
    <svg id="btn-arrow" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
    </svg>
    <svg id="btn-spinner" class="hidden w-4 h-4 animate-spin" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
    </svg>
  </button>

  <!-- Success message -->
  <div id="form-success" class="hidden bg-green-50 border border-green-200 rounded-xl p-5 flex items-start gap-3">
    <svg class="w-5 h-5 text-green-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
    <div>
      <p class="font-body font-semibold text-green-800 text-sm">Inquiry sent successfully!</p>
      <p class="font-body text-green-700 text-sm mt-0.5">Thank you! Our export team will contact you within 24 hours.</p>
    </div>
  </div>

  <!-- Error message -->
  <div id="form-error" class="hidden bg-red-50 border border-red-200 rounded-xl p-5">
    <p class="font-body text-red-700 text-sm">Something went wrong. Please try again or email us directly at <a href={`mailto:${brand === 'citizen' ? 'info@citizenvegexports.com' : 'info@top-class.in'}`} class="font-semibold underline">{brand === 'citizen' ? 'info@citizenvegexports.com' : 'info@top-class.in'}</a>.</p>
  </div>

  <p class="text-xs text-brand-muted font-body">
    We respond to all export inquiries within 24 hours. Fields marked <span class="text-red-500">*</span> are required.
  </p>
</form>

<script>
  const form = document.getElementById('inquiry-form') as HTMLFormElement;
  const btn = document.getElementById('form-submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text')!;
  const btnArrow = document.getElementById('btn-arrow')!;
  const btnSpinner = document.getElementById('btn-spinner')!;
  const successMsg = document.getElementById('form-success')!;
  const errorMsg = document.getElementById('form-error')!;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btnText.textContent = 'Sending…';
    btnArrow.classList.add('hidden');
    btnSpinner.classList.remove('hidden');
    errorMsg.classList.add('hidden');

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const data = await res.json();
      if (data.success) {
        form.reset();
        successMsg.classList.remove('hidden');
        successMsg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        throw new Error('Submission failed');
      }
    } catch {
      errorMsg.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btnText.textContent = 'Send Export Inquiry';
      btnArrow.classList.remove('hidden');
      btnSpinner.classList.add('hidden');
    }
  });
</script>
